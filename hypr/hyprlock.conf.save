# Gruvbox Hyprlock Configuration
# Edge-distributed layout with central profile picture

# Gruvbox Color Palette
$bg = rgb(282828)           # gruvbox dark bg
$bg0 = rgb(1d2021)          # gruvbox darker bg
$bg1 = rgb(3c3836)          # gruvbox dark1
$fg = rgb(ebdbb2)           # gruvbox light fg
$fg2 = rgb(d5c4a1)          # gruvbox light2
$red = rgb(cc241d)          # gruvbox red
$green = rgb(98971a)        # gruvbox green
$yellow = rgb(d79921)       # gruvbox yellow
$blue = rgb(458588)         # gruvbox blue
$purple = rgb(b16286)       # gruvbox purple
$aqua = rgb(689d6a)         # gruvbox aqua
$orange = rgb(d65d0e)       # gruvbox orange

background {
    monitor =
    path = ~/Pictures/wallpapers/gruvbox.png   # You can replace with your preferred background image
    color = $bg0
    
    # Blur effect
    blur_passes = 2
    blur_size = 8
    noise = 0.0117
    contrast = 0.8916
    brightness = 0.8172
    vibrancy = 0.1696
    vibrancy_darkness = 0.0
}

# Profile Picture (center)
image {
    monitor =
    path = ~/Pictures/Terminal/profile.jpg   # Change this to your profile picture path
    size = 150
    rounding = -1   # -1 makes it circular
    border_size = 3
    border_color = $yellow
    position = 0, 80
    halign = center
    valign = center
}

# Username below profile picture
label {
    monitor =
    text = $USER
    color = $fg
    font_size = 32
    font_family = JetBrainsMono Nerd Font Bold
    position = 0, -20
    halign = center
    valign = center
}

# Input field below username
input-field {
    monitor =
    size = 350, 50
    outline_thickness = 2
    dots_size = 0.33
    dots_spacing = 0.15
    dots_center = true
    dots_rounding = -1
    outer_color = $bg1
    inner_color = $bg
    font_color = $fg
    fade_on_empty = true
    fade_timeout = 1000
    placeholder_text = <span foreground="##$fg2">Enter Password</span>
    hide_input = false
    rounding = 12
    check_color = $orange
    fail_color = $red
    fail_text = <span foreground="##$red">Authentication Failed</span>
    fail_transition = 300
    capslock_color = $yellow
    numlock_color = -1
    bothlock_color = -1
    invert_numlock = false
    swap_font_color = false
    
    position = 0, -100
    halign = center
    valign = center
}

# TOP LEFT - Time
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%H:%M")"
    color = $yellow
    font_size = 72
    font_family = JetBrainsMono Nerd Font Bold
    position = 50, -50
    halign = left
    valign = top
}

# TOP LEFT - Date (below time)
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%A")"
    color = $fg
    font_size = 24
    font_family = JetBrainsMono Nerd Font
    position = 50, -140
    halign = left
    valign = top
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%B %d, %Y")"
    color = $fg2
    font_size = 18
    font_family = JetBrainsMono Nerd Font
    position = 50, -170
    halign = left
    valign = top
}

# TOP RIGHT - Weather
label {
    monitor =
    text = cmd[update:300000] curl -s "wttr.in/?format=1" | head -c -1
    color = $aqua
    font_size = 20
    font_family = JetBrainsMono Nerd Font
    position = -50, -50
    halign = right
    valign = top
}

# TOP RIGHT - Temperature details
label {
    monitor =
    text = cmd[update:300000] curl -s "wttr.in/?format=%t+%h+%w" | sed 's/+/ • /g'
    color = $fg2
    font_size = 14
    font_family = JetBrainsMono Nerd Font
    position = -50, -80
    halign = right
    valign = top
}

# BOTTOM LEFT - System Info
label {
    monitor =
    text = $(hostname)
    color = $orange
    font_size = 18
    font_family = JetBrainsMono Nerd Font Bold
    position = 50, 50
    halign = left
    valign = bottom
}

label {
    monitor =
    text = cmd[update:5000] echo "uptime: $(uptime -p | sed 's/up //')"
    color = $fg2
    font_size = 14
    font_family = JetBrainsMono Nerd Font
    position = 50, 80
    halign = left
    valign = bottom
}

label {
    monitor =
    text = cmd[update:5000] echo "load: $(cat /proc/loadavg | cut -d' ' -f1-3)"
    color = $fg2
    font_size = 14
    font_family = JetBrainsMono Nerd Font
    position = 50, 105
    halign = left
    valign = bottom
}

# BOTTOM RIGHT - Hardware Info
label {
    monitor =
    text = cmd[update:5000] echo "$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null && echo "%" || echo "AC Power")"
    color = $green
    font_size = 16
    font_family = JetBrainsMono Nerd Font
    position = -50, 50
    halign = right
    valign = bottom
}

label {
    monitor =
    text = cmd[update:5000] echo "$(free -h | awk '/^Mem:/ {print $3"/"$2}')"
    color = $purple
    font_size = 14
    font_family = JetBrainsMono Nerd Font
    position = -50, 80
    halign = right
    valign = bottom
}

label {
    monitor =
    text = cmd[update:5000] echo "$(df -h / | awk 'NR==2 {print $3"/"$2" ("$5")"}')"
    color = $blue
    font_size = 14
    font_family = JetBrainsMono Nerd Font
    position = -50, 105
    halign = right
    valign = bottom
}

# CENTER BOTTOM - Status indicators
label {
    monitor =
    text = ● ● ● ● ●
    color = $bg1
    font_size = 12
    font_family = JetBrainsMono Nerd Font
    position = 0, -200
    halign = center
    valign = center
}

# Caps Lock indicator
label {
    monitor =
    text = cmd[update:1000] echo "$([ $(cat /sys/class/leds/input*::capslock/brightness 2>/dev/null) = "1" ] && echo "CAPS" || echo "")"
    color = $yellow
    font_size = 12
    font_family = JetBrainsMono Nerd Font Bold
    position = 0, 140
    halign = center
    valign = bottom
}
