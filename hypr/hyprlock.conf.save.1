$fg4 = rgb(a89984)          # dark beige
$accent = rgb(fabd2f)       # minimal yellow accent
$subtle = rgb(928374)       # muted grey

background {
    monitor =
    path = ~/Pictures/wallpapers/gruvbox.png
    color = $bg0
    
    # Blur effect
    blur_passes = 2
    blur_size = 8
    noise = 0.0117
    contrast = 0.8916
    brightness = 0.8172
    vibrancy = 0.1696
    vibrancy_darkness = 0.0
}

# Profile Picture (center) - rectangular
image {
    monitor =
    path = ~/Pictures/Terminal/profile.jpg
    size = 280, 200  # bigger rectangular dimensions
    rounding = 12    # subtle rounded corners
    border_size = 2
    border_color = $fg3
    position = 0, 50
    halign = center
    valign = center
}

# Input field below profile picture
input-field {
    monitor =
    size = 350, 50
    outline_thickness = 2
    dots_size = 0.33
    dots_spacing = 0.15
    dots_center = true
    dots_rounding = -1
    outer_color = $bg2
    inner_color = $bg1
    font_color = $fg
    fade_on_empty = true
    fade_timeout = 1000
    placeholder_text = <span foreground="##$fg3">Enter Password</span>
    hide_input = false
    rounding = 12
    check_color = $fg2
    fail_color = $accent
    fail_text = <span foreground="##$accent">Authentication Failed</span>
    fail_transition = 300
    capslock_color = $accent
    numlock_color = -1
    bothlock_color = -1
    invert_numlock = false
    swap_font_color = false
    
    position = 0, -120
    halign = center
    valign = center
}

# TOP LEFT - Time
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%H:%M")"
    color = $fg
    font_size = 64
    font_family = JetBrainsMono Nerd Font Bold
    position = 50, -50
    halign = left
    valign = top
}

# TOP LEFT - Date (below time)
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%A")"
    color = $fg2
    font_size = 22
    font_family = JetBrainsMono Nerd Font Medium
    position = 50, -130
    halign = left
    valign = top
}

label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%B %d, %Y")"
    color = $fg3
    font_size = 16
    font_family = JetBrainsMono Nerd Font
    position = 50, -155
    halign = left
    valign = top
}

# TOP RIGHT - Weather
label {
    monitor =
    text = cmd[update:300000] curl -s "wttr.in/?format=1" | head -c -1
    color = $fg2
    font_size = 18
    font_family = JetBrainsMono Nerd Font Medium
    position = -50, -50
    halign = right
    valign = top
}

# TOP CENTER - Location
label {
    monitor =
    text = Montreal, QC
    color = $fg2
    font_size = 16
    font_family = JetBrainsMono Nerd Font Medium
    position = 0, -50
    halign = center
    valign = top
}

# BOTTOM LEFT - Hostname only
label {
    monitor =
    text = $(hostname)
    color = $fg2
    font_size = 18
    font_family = JetBrainsMono Nerd Font Medium
    position = 50, 50
    halign = left
    valign = bottom
}

# BOTTOM RIGHT - Time zone only
label {
    monitor =
    text = cmd[update:1000] echo "$(date +"%Z %z")"
    color = $fg3
    font_size = 14
    font_family = JetBrainsMono Nerd Font
    position = -50, 50
    halign = right
    valign = bottom
}

# CENTER BOTTOM - Status indicators
label {
    monitor =
    text = ◦ ◦ ◦ ◦ ◦
    color = $subtle
    font_size = 10
    font_family = JetBrainsMono Nerd Font
    position = 0, -180
    halign = center
    valign = center
}

# Caps Lock indicator
label {
    monitor =
    text = cmd[update:1000] echo "$([ $(cat /sys/class/leds/input*::capslock/brightness 2>/dev/null) = "1" ] && echo "CAPS LOCK" || echo "")"
    color = $accent
    font_size = 11
    font_family = JetBrainsMono Nerd Font Medium
    position = 0, 120
    halign = center
    valign = bottom
}# Gruvbox Hyprlock Configuration
